# Copy this file to ".env" and adjust the values.
# If DATABASE_URL is not set, the site uses local JSON file.

# Server port
PORT=3000

# PostgreSQL (e.g., Neon, Supabase, Render). Leave empty to use local JSON.
DATABASE_URL=

# Enable SSL on PostgreSQL (required on Neon/Supabase)
PGSSL=true

# Admin credentials
ADMIN_USUARIO=admin
ADMIN_SENHA=nordivia2024

# Allowed CORS origin (use your domain in production)
CORS_ORIGIN=*