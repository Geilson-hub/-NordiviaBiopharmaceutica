# Copie este arquivo para ".env" e ajuste os valores.
# Se DATABASE_URL não for definido, o site usa arquivo JSON local.

# Porta do servidor
PORT=3000

# PostgreSQL (ex.: Neon, Supabase, Render). Deixe vazio para usar JSON local.
DATABASE_URL=

# Habilite SSL no PostgreSQL (necessário em Neon/Supabase)
PGSSL=true

# Credenciais do admin
ADMIN_USUARIO=admin
ADMIN_SENHA=nordivia2024